# Base de donnees
DB_ROOT_PASSWORD=CHANGE_ME
DB_NAME=dolibarr
DB_USER=dolibarruser
DB_PASSWORD=CHANGE_ME

# Compte administrateur Dolibarr (cree automatiquement au premier lancement)
DOLI_ADMIN_LOGIN=admin
DOLI_ADMIN_PASSWORD=CHANGE_ME
